+/* Copy a landscape frame to a portrait panel. 90: the panel's left side is up; 270: its right side is up. */
+static void drm_rotate_frame(const drm_dev_t * drm_dev, const uint8_t * src, drm_buffer_t * dst)
+{
+    const uint32_t w = drm_dev->width, h = drm_dev->height;
+    const bool left_up = drm_dev->rotation == 90;
+    const ptrdiff_t step = left_up ? -(ptrdiff_t)dst->pitch : (ptrdiff_t)dst->pitch;
+
+    for(uint32_t v = 0; v < w; v++) {
+        const uint32_t * row = (const uint32_t *)(src + v * drm_dev->rot_stride);
+        const uint32_t x = left_up ? v : w - 1 - v;
+        uint8_t * out = (uint8_t *)dst->map + (left_up ? (size_t)(h - 1) * dst->pitch : 0) + x * 4;
+        for(uint32_t u = 0; u < h; u++, out += step) *(uint32_t *)out = row[u];
+    }
+}
