+
+/* The panel's own size: rotation swaps the display's. */
+static void panel_size(const lv_display_t *display, int32_t *w, int32_t *h) {
+    *w = indev_rotation ? display->physical_ver_res : display->physical_hor_res;
+    *h = indev_rotation ? display->physical_hor_res : display->physical_ver_res;
+}
+
+/* Panel coordinates to screen coordinates; the inverse of drm_rotate_frame in LVGL's DRM driver. */
+static void rotate_point(int32_t *x, int32_t *y, int32_t w, int32_t h) {
+    const int32_t px = *x, py = *y;
+
+    if (indev_rotation == 90) {
+        *x = h - 1 - py;
+        *y = px;
+    } else if (indev_rotation == 270) {
+        *x = py;
+        *y = w - 1 - px;
+    }
+}
