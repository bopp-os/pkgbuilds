+lv_result_t lv_linux_drm_set_rotation(lv_display_t * disp, int degrees)
+{
+    drm_dev_t * drm_dev = lv_display_get_driver_data(disp);
+    lv_color_format_t cf = lv_display_get_color_format(disp);
+
+    if((degrees != 90 && degrees != 270) || lv_color_format_get_bpp(cf) != 32) return LV_RESULT_INVALID;
+
+    int32_t hor_res = drm_dev->height;
+    int32_t ver_res = drm_dev->width;
+    uint32_t stride = lv_draw_buf_width_to_stride(hor_res, cf);
+    size_t size = (size_t)stride * ver_res;
+    uint8_t * buf = malloc(size);
+    if(buf == NULL) return LV_RESULT_INVALID;
+
+    lv_display_set_resolution(disp, hor_res, ver_res);
+    lv_display_set_buffers_with_stride(disp, buf, NULL, size, stride, LV_DISPLAY_RENDER_MODE_FULL);
+    drm_dev->rot_stride = stride;
+    drm_dev->rotation = degrees;
+    return LV_RESULT_OK;
+}
